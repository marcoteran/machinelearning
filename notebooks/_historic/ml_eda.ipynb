# %%
instructor_X_train_raw, instructor_X_test_raw, instructor_y_train, instructor_y_test = train_test_split(
    X_full,
    y_full,
    test_size=0.20,
    random_state=SEED,
)

instructor_X_train = add_engineered_features(instructor_X_train_raw)
instructor_X_test = add_engineered_features(instructor_X_test_raw)

instructor_ordinal_cols = [col for col in ["income_band"] if col in instructor_X_train.columns]
instructor_categorical_all = instructor_X_train.select_dtypes(exclude=[np.number]).columns.tolist()
instructor_nominal_cols = [col for col in instructor_categorical_all if col not in instructor_ordinal_cols]
instructor_numeric_cols = instructor_X_train.select_dtypes(include=[np.number]).columns.tolist()

instructor_preprocessor = build_preprocessor(
    numeric_cols=instructor_numeric_cols,
    nominal_cols=instructor_nominal_cols,
    ordinal_cols=instructor_ordinal_cols,
    numeric_imputer_strategy="median",
    scale_numeric=True,
)

instructor_model = Pipeline([
    ("preprocess", instructor_preprocessor),
    ("regressor", LinearRegression()),
])

instructor_model.fit(instructor_X_train, instructor_y_train)
instructor_preds = instructor_model.predict(instructor_X_test)

instructor_report = regression_report(instructor_y_test, instructor_preds)
print_section("SOLUCIÓN BASE DEL INSTRUCTOR")
display(pd.DataFrame([instructor_report]))

